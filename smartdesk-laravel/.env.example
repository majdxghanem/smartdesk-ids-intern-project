APP_NAME=SmartDesk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173
APP_TIMEZONE=Asia/Beirut

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Gmail SMTP: enable Google 2-Step Verification and create an App Password.
# Fill in these values in your LOCAL .env, never commit actual credentials.
# Port 587 negotiates STARTTLS automatically when MAIL_SCHEME=null.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_sender@gmail.com
MAIL_PASSWORD=your_16_character_app_password
MAIL_FROM_ADDRESS=your_sender@gmail.com
MAIL_FROM_NAME="SmartDesk"

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SMARTDESK_ADMIN_PASSWORD=
SMARTDESK_DEMO_PASSWORD=
